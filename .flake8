[flake8]
max-line-length = 120
max-complexity = 15
show-source = True
statistics = True
count = True

# E203: conflicts with Black slicing
# E402: needed for dynamic backend/env setup
# E731: lambda assignment (style choice)
# E501 is NOT ignored — max-line-length enforces it at 120
# W503/W504: already in flake8 defaults; listed here for clarity
extend-ignore =
    E203,
    E402,
    E731,
    W503,
    W504

# Use extend-exclude to keep flake8's defaults (.git, __pycache__, .tox, .eggs, *.egg)
extend-exclude =
    .github,
    .trunk,
    .venv,
    venv,
    .nox,
    .pytest_cache,
    .mypy_cache,
    .ruff_cache,
    .hypothesis,
    .ipynb_checkpoints,
    build,
    dist,
    *.egg-info,
    htmlcov,
    .coverage,
    node_modules,
    _archive,
    _proposed,
    results,
    thesis_final,
    academic,
    paper,
    docs,
    logs,
    site,
    _build

# Per-file ignores:
#   __init__.py: re-exports appear unused
#   tests: broad patterns for E501/F401/F841
#   benchmarks: same
#   Note: fnmatch '*' does NOT cross '/', so subdirectories need explicit patterns
per-file-ignores =
    __init__.py: F401, F403
    conftest.py: F401
    tests/*: E501, F401, F841
    tests/*/*: E501, F401, F841
    tests/*/*/*: E501, F401, F841
    benchmarks/*: E501, F401, F841
    benchmarks/*/*: E501, F401, F841