# Author: Taha Majlesi
[flake8]
# Flake8 configuration for NeuralOps
max-line-length = 120
max-complexity = 18
show-source = True
statistics = True
count = True

# Ignore rules compatible with Black/Ruff code formatting & PyTorch/Triton idioms:
# E203: Whitespace before ':' (conflicts with Black slicing)
# E402: Module level import not at top of file (needed for dynamic backend/env setup)
# E501: Line too long (handled by Black / soft limit)
# E731: Do not assign a lambda expression, use a def
# W503: Line break occurred before a binary operator (PEP 8 recommends this now)
# W504: Line break occurred after a binary operator
extend-ignore =
    E203,
    E402,
    E501,
    E731,
    W503,
    W504

# Excluded directories and patterns:
exclude =
    .git,
    .github,
    .trunk,
    .venv,
    venv,
    __pycache__,
    build,
    dist,
    *.egg-info,
    _archive,
    results,
    thesis_final,
    academic,
    paper,
    docs,
    logs

# Per-file specific ignores:
per-file-ignores =
    # __init__.py modules expose public APIs that may appear unused
    __init__.py: F401, F403
    # Tests frequently use fixtures, broad assertions, and temporary tensors
    tests/*: E501, F401, F841
    benchmarks/*: E501, F401, F841
