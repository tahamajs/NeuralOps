{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "protocol": "socks",
      "listen": "127.0.0.1",
      "port": 1080,
      "settings": {
        "auth": "noauth",
        "udp": true,
        "ip": "127.0.0.1"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "vless-out",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "172.64.146.15",
            "port": 443,
            "users": [
              {
                "id": "788e0589-770e-4818-aa7b-9bfc547464c3",
                "encryption": "none",
                "flow": ""
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "vercel.ifilmino.com",
          "allowInsecure": false,
          "fingerprint": "firefox"
        },
        "xhttpSettings": {
          "path": "/x4TNy5V0HjfhbVDUaT0"
        }
      },
      "mux": {
        "enabled": false
      }
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["socks-in"],
        "outboundTag": "vless-out"
      }
    ]
  }
}