      "shape_transform": "[n_h \\cdot d_h \u00d7 d_c]",
      "color": "#b45309",
      "math_latex": "v^C_t = W^{UV} c^{KV}_t, \\quad W^{UV} \\in \\mathbb{R}^{n_h d_h \\times d_c}"
