#!/usr/bin/env bash
#PBS -N neuralops_bench
#PBS -q N3090
#PBS -l nodes=1:ppn=1
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail
export PYTHONIOENCODING=utf-8
export PYTHONPATH="/home/tahamajlesi.ut/venv_cu113/lib/python3.10/site-packages:/home/tahamajlesi.ut/NeuralOps:${PYTHONPATH:-}"
export LD_LIBRARY_PATH="/usr/local/cuda-11.3/lib64:/share/apps/Anaconda/anaconda3.8/lib:/share/apps/gcc/gcc-8.2.0/lib64:/home/tahamajlesi.ut/venv_cu113/lib:${LD_LIBRARY_PATH:-}"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

cd /home/tahamajlesi.ut/NeuralOps
mkdir -p results/screen_logs results/csv results/tables results/reports

PYTHON_EXEC=/home/tahamajlesi.ut/.conda/envs/neuralops/bin/python
LOG_FILE="results/screen_logs/gpu_benchmark_suite.log"
exec >> "$LOG_FILE" 2>&1

echo "======================================================================"
echo "  STARTING NEURALOPS GPU BENCHMARKS SUITE: $(date -u)"
echo "  Node: $(hostname) | GPU: $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null || echo 'Unknown')"
echo "======================================================================"

echo ""
echo ">>> [1/5] Running scripts/benchmarks/gpu_telemetry.py..."
"$PYTHON_EXEC" -u scripts/benchmarks/gpu_telemetry.py --json

echo ""
echo ">>> [2/5] Running scripts/benchmarks/gpu_master_suite.py (131 Attentions + 72 Compressors + Fallback Parity)..."
"$PYTHON_EXEC" -u scripts/benchmarks/gpu_master_suite.py --device cuda:0 --export

echo ""
echo ">>> [3/5] Running neuralops/benchmarks/benchmark_all_26_comprehensive.py..."
"$PYTHON_EXEC" -u neuralops/benchmarks/benchmark_all_26_comprehensive.py --device cuda:0

echo ""
echo ">>> [4/5] Running scripts/benchmarks/benchmark_kd_all_modules.py (Per-module 2-min KD runs)..."
"$PYTHON_EXEC" -u scripts/benchmarks/benchmark_kd_all_modules.py \
    --device cuda:0 \
    --max-duration 120.0 \
    --category all \
    --output-csv results/csv/kd_per_module_benchmark.csv \
    --output-sqlite results/master_ledger.sqlite

echo ""
echo ">>> [5/5] Consolidating and organizing all benchmark outputs..."
"$PYTHON_EXEC" -u scripts/benchmarks/consolidate_and_organize_benchmarks.py

echo ""
echo "======================================================================"
echo "  BENCHMARKS SUITE FINISHED: $(date -u)"
echo "======================================================================"
