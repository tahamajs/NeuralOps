#PBS -N kd_layerwise_all
#PBS -q N3090
#PBS -l nodes=1:ppn=1
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o results/screen_logs/run_kd_layerwise_all.log

cd "$PBS_O_WORKDIR" || exit 1

export PATH="/share/apps/gcc/gcc-8.2.0/bin:/usr/local/cuda-11.3/bin:${PATH:-}"
export LD_LIBRARY_PATH="/share/apps/gcc/gcc-8.2.0/lib64:/share/apps/gcc/gcc-8.2.0/lib:/usr/local/cuda-11.3/lib64:/share/apps/Anaconda/anaconda3.8/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="${PWD}:${PYTHONPATH:-}"
export PYTORCH_CUDA_ALLOC_CONF="max_split_size_mb:128"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1

PYTHON_EXEC=/home/tahamajlesi.ut/.conda/envs/neuralops_cu113/bin/python3

echo "======================================================================"
echo "  LAYERWISE 6-PILLAR KD BENCHMARK ON ALL MODULES (RTX 3090)"
echo "  Date: $(date -u)"
echo "  Node: $(hostname)"
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
echo "======================================================================"

$PYTHON_EXEC scripts/benchmarks/run_layerwise_cached_kd_ablation.py \
    --all-modules \
    --device cuda:0 \
    --batch-size 32 \
    --out-json results/sst2_layerwise_kd_ablation_full.json \
    --out-csv results/sst2_layerwise_kd_ablation_full.csv \
    --ledger-db results/master_ledger.sqlite

STATUS=$?
echo "Exit code: $STATUS"
exit $STATUS
