#PBS -N neuralops_multiseed_rigor
#PBS -q N3090
#PBS -l nodes=1:ppn=1
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail
export PYTHONIOENCODING=utf-8
export PATH="/share/apps/gcc/gcc-8.2.0/bin:/usr/local/cuda-11.3/bin:${PATH:-}"
export LD_LIBRARY_PATH="/share/apps/gcc/gcc-8.2.0/lib64:/share/apps/gcc/gcc-8.2.0/lib:/usr/local/cuda-11.3/lib64:/share/apps/Anaconda/anaconda3.8/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="${PWD}:${PYTHONPATH:-}"
export PYTORCH_CUDA_ALLOC_CONF="max_split_size_mb:128"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

cd /home/tahamajlesi.ut/NeuralOps
mkdir -p results/screen_logs results/multiseed results/tables

PYTHON_EXEC=/home/tahamajlesi.ut/.conda/envs/neuralops/bin/python
LOG_FILE="results/screen_logs/gpu_multiseed_rigor_3090.log"
exec >> "$LOG_FILE" 2>&1

echo "======================================================================"
echo "  STARTING MULTI-SEED STATISTICAL RIGOR & COLD-CACHE BENCHMARKS: $(date -u)"
echo "  Node: $(hostname) | GPU: $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null || echo 'Unknown')"
echo "======================================================================"

echo ""
echo ">>> [1/3] Multi-Seed Dual-Tier Rigor (Standard Canonical + Adversarial Stress Seeds)..."
"$PYTHON_EXEC" -u -m neuralops multiseed \
    --modules attention:full_attention,attention:cosformer,attention:gated_delta_net \
    --preset dual_tier \
    --baseline attention:full_attention \
    --device cuda:0 \
    --seq-len 1024 \
    --batch-size 2 \
    --hidden-dim 128 \
    --dtype float32 \
    --flush-l2 \
    --l2-size-mb 256 \
    --output-dir results/multiseed/dual_tier \
    --latex

echo ""
echo ">>> [2/3] Enterprise 5-Seed Statistical Significance Matrix..."
"$PYTHON_EXEC" -u -m neuralops multiseed \
    --modules attention:full_attention,attention:linear_attention,attention:cosformer,attention:recurrent_retention \
    --preset enterprise5 \
    --baseline attention:full_attention \
    --device cuda:0 \
    --seq-len 2048 \
    --batch-size 1 \
    --hidden-dim 256 \
    --dtype float16 \
    --flush-l2 \
    --l2-size-mb 256 \
    --output-dir results/multiseed/enterprise5 \
    --latex

echo ""
echo ">>> [3/3] Canonical 7-Seed Extended Evaluation..."
"$PYTHON_EXEC" -u -m neuralops multiseed \
    --modules attention:full_attention,attention:cosformer \
    --preset canonical7 \
    --baseline attention:full_attention \
    --device cuda:0 \
    --seq-len 512 \
    --batch-size 4 \
    --hidden-dim 64 \
    --flush-l2 \
    --output-dir results/multiseed/canonical7 \
    --latex

echo ""
echo "======================================================================"
echo "  MULTI-SEED STATISTICAL RIGOR SUITE FINISHED: $(date -u)"
echo "======================================================================"
