#!/bin/bash
#PBS -N run_all_notebooks_gpu
#PBS -q N3090
#PBS -l nodes=1:ppn=1
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o results/screen_logs/run_all_notebooks_gpu.log

cd /home/tahamajlesi.ut/NeuralOps || exit 1
mkdir -p results/screen_logs results/notebooks_executed

export PATH="/share/apps/gcc/gcc-8.2.0/bin:/usr/local/cuda-11.3/bin:${PATH:-}"
export LD_LIBRARY_PATH="/home/tahamajlesi.ut/.conda/envs/neuralops_cu113/lib:/share/apps/gcc/gcc-8.2.0/lib64:/share/apps/gcc/gcc-8.2.0/lib:/usr/local/cuda-11.3/lib64:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="/home/tahamajlesi.ut/NeuralOps:${PYTHONPATH:-}"
export MPLBACKEND="Agg"
export PYTHONIOENCODING="utf-8"

PYTHON_EXEC=/home/tahamajlesi.ut/.conda/envs/neuralops_cu113/bin/python3

echo "======================================================================"
echo "  PHYSICAL GPU BATCH RUNNER FOR ALL 94 CANONICAL NOTEBOOKS"
echo "  Date: $(date -u)"
echo "  Node: $(hostname)"
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
echo "======================================================================"

$PYTHON_EXEC scripts/batch_run_all_notebooks.py 2>&1 | tee results/notebooks_execution.log
STATUS=$?
echo "Exit code: $STATUS"
exit $STATUS
