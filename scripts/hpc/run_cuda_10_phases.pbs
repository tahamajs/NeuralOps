#!/bin/bash
#PBS -N cuda_10_phases
#PBS -q N3090
#PBS -l nodes=1:ppn=1
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -o results/screen_logs/run_cuda_10_phases.log

cd "$PBS_O_WORKDIR" || exit 1

export PATH="/share/apps/gcc/gcc-8.2.0/bin:/usr/local/cuda-11.3/bin:${PATH:-}"
export LD_LIBRARY_PATH="/share/apps/gcc/gcc-8.2.0/lib64:/share/apps/gcc/gcc-8.2.0/lib:/usr/local/cuda-11.3/lib64:/share/apps/Anaconda/anaconda3.8/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="${PWD}:${PYTHONPATH:-}"
export PYTORCH_CUDA_ALLOC_CONF="max_split_size_mb:128"

PYTHON_EXEC=/home/tahamajlesi.ut/.conda/envs/neuralops_cu113/bin/python3

echo "======================================================================"
echo "  CUDA 10-PHASE PERFORMANCE BENCHMARK ON NVIDIA RTX 3090"
echo "  Date: $(date -u)"
echo "  Node: $(hostname)"
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
echo "======================================================================"

$PYTHON_EXEC neuralops/benchmarks/legacy_scripts/benchmark_10_phases_cuda.py --device cuda:0 --output results/cuda_10_phases_rtx3090.csv
STATUS=$?
echo "Exit code: $STATUS"
exit $STATUS
