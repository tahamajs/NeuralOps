#!/usr/bin/env bash
#PBS -N opt_single_kd
#PBS -q N3090
#PBS -l nodes=1:ppn=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -euo pipefail
export PYTHONIOENCODING=utf-8
export PATH="/share/apps/gcc/gcc-8.2.0/bin:/usr/local/cuda-11.3/bin:${PATH:-}"
export LD_LIBRARY_PATH="/share/apps/gcc/gcc-8.2.0/lib64:/share/apps/gcc/gcc-8.2.0/lib:/usr/local/cuda-11.3/lib64:/share/apps/Anaconda/anaconda3.8/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="${PWD}:${PYTHONPATH:-}"
export PYTORCH_CUDA_ALLOC_CONF="max_split_size_mb:128"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

cd /home/tahamajlesi.ut/NeuralOps
mkdir -p results/screen_logs results/csv

PYTHON_EXEC=/home/tahamajlesi.ut/.conda/envs/neuralops_cu113/bin/python

MODULE_NAME="${TARGET_MODULE:-adaptive_span_attention}"
MODULE_TYPE="${TARGET_TYPE:-attention}"
DURATION="${MAX_DURATION:-120.0}"
PEAK_LR="${LEARNING_RATE:-0.001}"

echo "======================================================================"
echo "  STARTING SINGLE-MODULE OPTIMIZED 6-PILLAR KD ON NVIDIA RTX 3090"
echo "  Timestamp: $(date -u)"
echo "  Node     : $(hostname)"
echo "  Module   : ${MODULE_NAME} (${MODULE_TYPE})"
echo "  Duration : ${DURATION}s | Peak LR: ${PEAK_LR}"
echo "======================================================================"

"$PYTHON_EXEC" -u neuralops/benchmarks/legacy_scripts/benchmark_single_optimized_kd.py \
    --module "${MODULE_NAME}" \
    --category "${MODULE_TYPE}" \
    --device cuda:0 \
    --duration "${DURATION}" \
    --lr "${PEAK_LR}" \
    --batch-size 8 \
    --seq-len 128 \
    --output-csv results/csv/single_optimized_kd_${MODULE_NAME}.csv

echo "======================================================================"
echo "  SINGLE-MODULE OPTIMIZATION FINISHED: $(date -u)"
echo "======================================================================"
