#PBS -N master_bench_suite
#PBS -q N3090
#PBS -l nodes=1:ppn=1
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o results/screen_logs/run_master_complete_benchmarks.log

cd "$PBS_O_WORKDIR" || cd /home/tahamajlesi.ut/NeuralOps || exit 1

export PATH="/share/apps/gcc/gcc-8.2.0/bin:/usr/local/cuda-11.3/bin:${PATH:-}"
export LD_LIBRARY_PATH="/share/apps/gcc/gcc-8.2.0/lib64:/share/apps/gcc/gcc-8.2.0/lib:/usr/local/cuda-11.3/lib64:/share/apps/Anaconda/anaconda3.8/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="${PWD}:${PYTHONPATH:-}"
export PYTORCH_CUDA_ALLOC_CONF="max_split_size_mb:128"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export PYTHONIOENCODING=utf-8

PYTHON_EXEC=/home/tahamajlesi.ut/.conda/envs/neuralops_cu113/bin/python3

mkdir -p results/screen_logs results/multiseed/dual_tier results/multiseed/enterprise5 results/multiseed/canonical7 results/csv

echo "======================================================================"
echo "  NEURALOPS COMPLETE MASTER BENCHMARK SUITE ON NVIDIA RTX 3090"
echo "  Date: $(date -u)"
echo "  Node: $(hostname)"
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
echo "======================================================================"

# -----------------------------------------------------------------------------
# Phase 1: 131 Attention Mechanisms & 6-Pillar KD Layerwise Ablation (Resume)
# -----------------------------------------------------------------------------
echo ""
echo ">>> [Phase 1/5] Resuming 6-Pillar KD Layerwise Ablation (All 131 Modules)..."
$PYTHON_EXEC scripts/benchmarks/run_layerwise_cached_kd_ablation.py \
    --all-modules \
    --resume \
    --device cuda:0 \
    --batch-size 32 \
    --out-json results/sst2_layerwise_kd_ablation_full.json \
    --out-csv results/sst2_layerwise_kd_ablation_full.csv \
    --ledger-db results/master_ledger.sqlite || echo "[WARN] Phase 1 finished with warnings"

# -----------------------------------------------------------------------------
# Phase 2: 26 Comprehensive Triton Kernels Benchmark & Parity Audit
# -----------------------------------------------------------------------------
echo ""
echo ">>> [Phase 2/5] Running 26 Triton Kernels Benchmark & Parity Audit..."
$PYTHON_EXEC neuralops/benchmarks/benchmark_all_26_comprehensive.py \
    --device cuda:0 \
    --dtype float16 \
    --warmup 5 \
    --repeat 25 \
    --output results/triton_26_kernels_comprehensive_benchmark.csv \
    --output-json results/triton_26_kernels_comprehensive_benchmark.json \
    --report-md docs/reports/TRITON_26_KERNELS_COMPREHENSIVE_REPORT.md || echo "[WARN] Phase 2 finished with warnings"

# -----------------------------------------------------------------------------
# Phase 3: Complete 10 Competitors Benchmark Suite
# -----------------------------------------------------------------------------
echo ""
echo ">>> [Phase 3/5] Running Competitor Benchmark Suite (10 Competitors)..."
$PYTHON_EXEC neuralops/benchmarks/legacy_scripts/run_parallel_competitor_suite.py || echo "[WARN] Phase 3 finished with warnings"

# -----------------------------------------------------------------------------
# Phase 4: Multi-Seed Statistical Rigor Benchmarks (Dual-Tier & Enterprise)
# -----------------------------------------------------------------------------
echo ""
echo ">>> [Phase 4/5] Running Multi-Seed Statistical Rigor Benchmarks..."
$PYTHON_EXEC -u -m neuralops multiseed \
    --modules attention:full_attention,attention:cosformer,attention:gated_delta_net \
    --preset dual_tier \
    --baseline attention:full_attention \
    --device cuda:0 \
    --seq-len 1024 \
    --batch-size 2 \
    --hidden-dim 128 \
    --dtype float32 \
    --flush-l2 \
    --l2-size-mb 256 \
    --output-dir results/multiseed/dual_tier \
    --latex || echo "[WARN] Phase 4 dual_tier finished with warnings"

$PYTHON_EXEC -u -m neuralops multiseed \
    --modules attention:full_attention,attention:linear_attention,attention:cosformer,attention:recurrent_retention \
    --preset enterprise5 \
    --baseline attention:full_attention \
    --device cuda:0 \
    --seq-len 2048 \
    --batch-size 1 \
    --hidden-dim 256 \
    --dtype float16 \
    --flush-l2 \
    --l2-size-mb 256 \
    --output-dir results/multiseed/enterprise5 \
    --latex || echo "[WARN] Phase 4 enterprise5 finished with warnings"

# -----------------------------------------------------------------------------
# Phase 5: Real Long-Context VRAM Scaling (512 to 32k)
# -----------------------------------------------------------------------------
echo ""
echo ">>> [Phase 5/5] Running Real Long-Context VRAM Scaling Sweep (512 to 32k)..."
$PYTHON_EXEC scripts/benchmarks/run_real_long_context_vram_scaling.py \
    --device cuda:0 \
    --output-file results/benchmarks_long_context_scaling.json || echo "[WARN] Phase 5 finished with warnings"

echo ""
echo "======================================================================"
echo "  MASTER BENCHMARKS SUITE COMPLETED: $(date -u)"
echo "======================================================================"
