#!/bin/bash
#PBS -N audit_kernel_validation
#PBS -q N3090
#PBS -l nodes=1:ppn=1
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o run_audit_validation.out

cd "$PBS_O_WORKDIR" || exit 1

export PATH="/share/apps/gcc/gcc-8.2.0/bin:/usr/local/cuda-11.3/bin:${PATH:-}"
export LD_LIBRARY_PATH="/share/apps/gcc/gcc-8.2.0/lib64:/share/apps/gcc/gcc-8.2.0/lib:/usr/local/cuda-11.3/lib64:/share/apps/Anaconda/anaconda3.8/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="${PWD}:${PYTHONPATH:-}"
export PYTORCH_CUDA_ALLOC_CONF="max_split_size_mb:128"

PYTHON_EXEC=/home/tahamajlesi.ut/.conda/envs/neuralops_cu113/bin/python

echo "======================================================================"
echo "  AUDIT VALIDATION SUITE ON NVIDIA RTX 3090"
echo "  Timestamp: $(date -u)"
echo "  Node     : $(hostname)"
echo "  GPU Info :"
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
echo "======================================================================"

echo ""
echo ">>> STEP 1: VALIDATING 4 CRITICAL CUDA KERNELS (STRICT NATIVE + PARITY)"
$PYTHON_EXEC scripts/benchmarks/validate_4_cuda_kernels.py
CUDA_EXIT=$?
echo "CUDA Validation Exit Code: $CUDA_EXIT"

echo ""
echo ">>> STEP 2: RUNNING BENCHMARK ALL 26 TRITON KERNELS (STRICT GATES)"
$PYTHON_EXEC neuralops/benchmarks/benchmark_all_26_comprehensive.py --device cuda:0 --dtype float16 --warmup 5 --repeat 20 --output results/triton_26_kernels_audit_2026-11-03.csv --output-json results/triton_26_kernels_audit_2026-11-03.json
TRITON_EXIT=$?
echo "Triton 26 Benchmark Exit Code: $TRITON_EXIT"

echo ""
echo ">>> STEP 3: RUNNING ISOLATED TRITON SCAN PARITY TESTS"
$PYTHON_EXEC -m pytest tests/triton_parity/test_lightning_scan_parity.py tests/triton_parity/test_rwkv6_scan_parity.py tests/triton_parity/test_based_scan_parity.py -v --tb=short
PYTEST_EXIT=$?
echo "Parity Tests Exit Code: $PYTEST_EXIT"

echo "======================================================================"
echo "  ALL AUDIT PHASES COMPLETED. Summary:"
echo "  CUDA Status   : $CUDA_EXIT"
echo "  Triton Status : $TRITON_EXIT"
echo "  PyTest Status : $PYTEST_EXIT"
echo "======================================================================"
