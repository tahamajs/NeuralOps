#PBS -N full_examples_gpu
#PBS -q N3090
#PBS -l nodes=1:ppn=1
#PBS -l walltime=00:30:00
#PBS -o /home/tahamajlesi.ut/examples_full_gpu_v2.out
#PBS -e /home/tahamajlesi.ut/examples_full_gpu_v2.err

set -u
cd /home/tahamajlesi.ut/NeuralOps

export PATH="/share/apps/gcc/gcc-8.2.0/bin:/usr/local/cuda-11.3/bin:${PATH:-}"
export LD_LIBRARY_PATH="/share/apps/gcc/gcc-8.2.0/lib64:/share/apps/gcc/gcc-8.2.0/lib:/usr/local/cuda-11.3/lib64:/share/apps/Anaconda/anaconda3.8/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="${PWD}:${PYTHONPATH:-}"
export PYTORCH_CUDA_ALLOC_CONF="max_split_size_mb:128"
export PY="/home/tahamajlesi.ut/.conda/envs/neuralops_cu113/bin/python"
unset PYTHONHOME
export PYTHONNOUSERSITE=1

echo "START=$(date -Iseconds)"
"$PY" - <<'PY'
import sys, torch
print("TORCH=", torch.__version__)
print("CUDA=", torch.version.cuda, torch.cuda.is_available(), torch.cuda.get_device_name(0) if torch.cuda.is_available() else "NONE")
if not torch.cuda.is_available():
    sys.exit(1)
PY

echo "NVIDIA_SMI_BEGIN"
nvidia-smi
echo "NVIDIA_SMI_END"

FAILURES=0
for script in $(ls examples/[0-9]*.py | sort); do
    base=$(basename "$script")
    echo "=== BEGIN $base $(date -Iseconds) ==="
    "$PY" "$script"
    rc=$?
    echo "=== END $base rc=$rc $(date -Iseconds) ==="
    if [ $rc -ne 0 ]; then
        FAILURES=$((FAILURES + 1))
    fi
done

echo "END=$(date -Iseconds) TOTAL_FAILURES=$FAILURES"
exit $FAILURES
