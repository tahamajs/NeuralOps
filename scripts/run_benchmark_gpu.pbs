#PBS -N neuralops_benchmark
#PBS -q N3090
#PBS -l nodes=1:ppn=1
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:-$HOME/NeuralOps}"
export LD_LIBRARY_PATH="/share/apps/gcc/gcc-8.2.0/lib64:/share/apps/Anaconda/anaconda3.8/lib:/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="${PWD}:${PYTHONPATH:-}"
PY="${NEURALOPS_PYTHON:-$HOME/.conda/envs/neuralops_cu113/bin/python}"
MODE="${NEURALOPS_BENCHMARK_MODE:-serving}"
CONFIG="${NEURALOPS_BENCHMARK_CONFIG:-benchmarks/configs/quick_cuda.json}"
exec "${PY}" -m "neuralops.benchmarks.${MODE}" --config "${CONFIG}"
