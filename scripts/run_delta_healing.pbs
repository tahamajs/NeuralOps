#!/usr/bin/env bash
#PBS -N delta_healing
#PBS -q N3090
#PBS -l nodes=1:ppn=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -euo pipefail
export PYTHONIOENCODING=utf-8
export PATH="/share/apps/gcc/gcc-8.2.0/bin:/usr/local/cuda-11.3/bin:${PATH:-}"
export LD_LIBRARY_PATH="/share/apps/gcc/gcc-8.2.0/lib64:/usr/local/cuda-11.3/lib64:/share/apps/Anaconda/anaconda3.8/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="/home/tahamajlesi.ut/NeuralOps:${PYTHONPATH:-}"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

cd /home/tahamajlesi.ut/NeuralOps
mkdir -p results/screen_logs results/csv

PYTHON_EXEC=/home/tahamajlesi.ut/.conda/envs/neuralops_cu113/bin/python

MODULE_NAME="${TARGET_MODULE:-adaptive_span_attention}"
DURATION="${MAX_DURATION:-120.0}"
PEAK_LR="${LEARNING_RATE:-0.001}"

echo "======================================================================"
echo "  STARTING DEDICATED DELTA HEALING BENCHMARK ON NVIDIA RTX 3090"
echo "  Timestamp: $(date -u)"
echo "  Node     : $(hostname)"
echo "  Module   : ${MODULE_NAME}"
echo "  Duration : ${DURATION}s | Peak LR: ${PEAK_LR}"
echo "======================================================================"

"$PYTHON_EXEC" -u scripts/benchmarks/benchmark_delta_healing.py \
    --module "${MODULE_NAME}" \
    --device cuda:0 \
    --duration "${DURATION}" \
    --lr "${PEAK_LR}" \
    --output results/delta_healing_${MODULE_NAME}.json

echo "======================================================================"
echo "  DELTA HEALING COMPLETE: $(date -u)"
echo "======================================================================"
