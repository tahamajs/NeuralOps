#!/usr/bin/env bash
#PBS -N run_all_examples
#PBS -q N3090
#PBS -l nodes=1:ppn=1
#PBS -l walltime=02:00:00
#PBS -j oe

set -uo pipefail
export PYTHONIOENCODING=utf-8
export PATH="/share/apps/gcc/gcc-8.2.0/bin:/usr/local/cuda-11.3/bin:${PATH:-}"
export LD_LIBRARY_PATH="/share/apps/gcc/gcc-8.2.0/lib64:/usr/local/cuda-11.3/lib64:/share/apps/Anaconda/anaconda3.8/lib:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="/home/tahamajlesi.ut/NeuralOps:${PYTHONPATH:-}"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export CUDA_VISIBLE_DEVICES=0

cd /home/tahamajlesi.ut/NeuralOps
mkdir -p results/examples_logs

PYTHON_EXEC=/home/tahamajlesi.ut/.conda/envs/neuralops_cu113/bin/python

echo "======================================================================"
echo "  STARTING COMPLETE EXAMPLES SUITE EXECUTION ON NVIDIA RTX 3090"
echo "  Timestamp: $(date -u)"
echo "  Node     : $(hostname)"
echo "  GPU Info :"
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
echo "======================================================================"

TOTAL=0
PASSED=0
FAILED=0

# Iterate through all numbered tutorial examples in strict order
for script in $(ls examples/[0-9][0-9]_*.py | sort); do
    TOTAL=$((TOTAL + 1))
    base=$(basename "$script" .py)
    log_file="results/examples_logs/${base}.log"
    echo "----------------------------------------------------------------------"
    echo "[${TOTAL}] Running: ${script} on GPU..."
    t_start=$(date +%s)
    
    if "$PYTHON_EXEC" -u "$script" > "$log_file" 2>&1; then
        t_end=$(date +%s)
        dur=$((t_end - t_start))
        echo "  -> Status: PASS (${dur}s)"
        PASSED=$((PASSED + 1))
    else
        t_end=$(date +%s)
        dur=$((t_end - t_start))
        echo "  -> Status: FAIL (${dur}s) - Check ${log_file}"
        tail -n 10 "$log_file"
        FAILED=$((FAILED + 1))
    fi
done

echo "======================================================================"
echo "  EXAMPLES EXECUTION SUMMARY: $(date -u)"
echo "  Total: ${TOTAL} | Passed: ${PASSED} | Failed: ${FAILED}"
echo "======================================================================"
