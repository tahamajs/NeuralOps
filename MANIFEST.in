include LICENSE
include README.md
include CHANGELOG.md
include pyproject.toml
include neuralops/core/deprecated_aliases.json
include neuralops/benchmarks/discovery_overrides.json
include neuralops/py.typed

recursive-include neuralops *.pyi

recursive-exclude neuralops/data/glue_data *
recursive-exclude neuralops/tests *
recursive-exclude neuralops/benchmarks/_legacy *
recursive-exclude neuralops/_archive *
recursive-exclude neuralops/core/_archive *
recursive-exclude neuralops/attentions/_legacy *
recursive-exclude neuralops/compression_engine/_legacy *
recursive-exclude tests *
recursive-exclude scripts *
recursive-exclude results *

global-exclude *.arrow
global-exclude *.parquet
global-exclude *.h5
global-exclude *.pyc
global-exclude *.pyo
global-exclude __pycache__
global-exclude *.bak
global-exclude *.err
global-exclude *.log
global-exclude .DS_Store
global-exclude *.swp
