{
  "model_name": "bert-base-uncased",
  "task_name": "mrpc",
  "save_config": {
    "save_model": true,
    "save_checkpoints": true,
    "save_optimizer": false,
    "save_logs": true,
    "save_plots": true,
    "save_artifacts": true,
    "create_model_version": true,

    "storage_backends": ["local", "s3"],
    "auto_save_if_better_than": 0.85,

    "git_options": {
      "commit_results": true,
      "push_to_remote": true,
      "use_git_lfs": true,
      "git_lfs_threshold_mb": 10,
      "auto_tag": true,
      "tag_pattern": "v{version}-{accuracy}"
    },

    "dvc_options": {
      "track_model": true,
      "track_data": true,
      "remote_storage": "s3://my-bucket/dvc-store",
      "auto_push": true
    },

    "experiment_trackers": ["mlflow", "wandb"],

    "model_export_formats": ["onnx", "torchscript", "tflite", "tensorrt"],

    "cloud_options": {
      "aws_s3_bucket": "my-models",
      "gcp_bucket": "my-gcp-bucket",
      "azure_container": "my-container",
      "region": "us-east-1"
    },

    "model_registries": ["huggingface_hub", "docker_hub", "oci_registry"],

    "metadata_store": "openmetadata",

    "docker_options": {
      "base_image": "python:3.10-slim",
      "registry": "ghcr.io/myorg",
      "tag": "latest"
    },

    "release_options": {
      "create_github_release": true,
      "release_notes_template": "Model {version} - accuracy: {accuracy}",
      "attach_artifacts": ["model.onnx", "model.pth"]
    },

    "notification": {
      "on_success": ["email", "slack"],
      "on_failure": ["email"],
      "slack_webhook": "https://hooks.slack.com/...",
      "email_recipients": ["team@example.com"]
    }
  }
}