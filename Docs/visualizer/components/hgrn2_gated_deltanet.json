  "paradigm": "ssm",
  "icon": "\ud83d\udc0d",
  "description": "HGRN-2 Gated DeltaNet Hybrid Attention Module.  Combines bidirectional/causal HGRN-2 element-wise linear recurrence with multi-head Gated DeltaNet associative matrix memory for rich representational capacity. Hardened across DistilBERT, RoBERTa, GPT-2, and Qwen3.5 architectures.",
  "classes": [
    "HGRN2GatedDeltaNet"
  ],
  "methods_count": 6,
  "math_latex": "\\begin{aligned}\nY_{\\text{hgrn}} &= \\text{HGRN2}(X) \\\\\nY_{\\text{deltanet}} &= \\text{GatedDeltaNet}(X) \\\\\n\\gamma &= \\sigma(W_g X) \\\\\nY &= \\gamma \\odot Y_{\\text{hgrn}} + (1 - \\gamma) \\odot Y_{\\text{deltanet}} \\\\\n\\text{Output} &= Y W_o\n\\end{aligned}",
  "components": [
    {
      "id": "in_proj",
      "name": "Input SVD / Linear Projection",
      "role": "Channel Expansion",
      "shape_transform": "[2 \\cdot d_{in} \u00d7 d_{in}]",
      "color": "#34d399",
      "math_latex": "u_t = \\text{SiLU}(x_t W_{in}), \\quad W_{in} \\in \\mathbb{R}^{2 d_{in} \\times d_{in}}"
    },
    {
      "id": "conv1d",
      "name": "Depthwise Causal 1D Convolution",
      "role": "Local Token Mixing",
      "shape_transform": "[d_{inner} \u00d7 kernel=4]",
      "color": "#10b981",
      "math_latex": "x'_t = \\sum_{k=0}^{K-1} w_k \\cdot x_{t-k}"
    },
    {
      "id": "ssm_recurrence",
      "name": "Selective SSM Recurrence Matrix (A, B, C)",
      "role": "Continuous-Time State Space",
      "shape_transform": "[d_{state}=16 \u00d7 d_{inner}]",
      "color": "#059669",
      "math_latex": "h_t = \\bar{A} h_{t-1} + \\bar{B} x'_t, \\quad y_t = C h_t + D x'_t"
    },
    {
      "id": "out_proj",
      "name": "Output Gated Projection",
      "role": "Dimension Recovery",
      "shape_transform": "[d_{in} \u00d7 d_{inner}]",
      "color": "#047857",
      "math_latex": "y_t = u_t \\odot (h_t W_{out})"
    }
  ],
