  "description": "Selective State Space Model (SelectiveSSM).  Faithful implementation of Mamba-style selective state space recurrence block. Features: - State dimension (B, D, L, N) - Selective (input-dependent) Delta, B, C parameters - Structured A matrix initialization (Mamba paper Eq. 11) - Depthwise 1D convolution with SiLU gating - Bidirectional support with independent forward and backward parameters - No in",
  "classes": [
    "SelectiveSSM"
  ],
  "methods_count": 6,
  "math_latex": "h'(t) = A h(t) + B x(t)",
  "components": [
    {
      "id": "in_proj",
      "name": "Input SVD / Linear Projection",
      "role": "Channel Expansion",
      "shape_transform": "[2 \\cdot d_{in} \u00d7 d_{in}]",
      "color": "#34d399",
      "math_latex": "u_t = \\text{SiLU}(x_t W_{in}), \\quad W_{in} \\in \\mathbb{R}^{2 d_{in} \\times d_{in}}"
    },
    {
      "id": "conv1d",
      "name": "Depthwise Causal 1D Convolution",
      "role": "Local Token Mixing",
      "shape_transform": "[d_{inner} \u00d7 kernel=4]",
      "color": "#10b981",
      "math_latex": "x'_t = \\sum_{k=0}^{K-1} w_k \\cdot x_{t-k}"
    },
    {
      "id": "ssm_recurrence",
      "name": "Selective SSM Recurrence Matrix (A, B, C)",
      "role": "Continuous-Time State Space",
      "shape_transform": "[d_{state}=16 \u00d7 d_{inner}]",
      "color": "#059669",
      "math_latex": "h_t = \\bar{A} h_{t-1} + \\bar{B} x'_t, \\quad y_t = C h_t + D x'_t"
    },
    {
      "id": "out_proj",
      "name": "Output Gated Projection",
      "role": "Dimension Recovery",
      "shape_transform": "[d_{in} \u00d7 d_{inner}]",
      "color": "#047857",
      "math_latex": "y_t = u_t \\odot (h_t W_{out})"
    }
  ],
